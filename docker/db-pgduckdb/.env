COMPOSE_PROJECT_NAME=pgduckdb

# https://hub.docker.com/r/pgduckdb/pgduckdb/tags (16-main, 17-main, 17-v0.3.1, ...)
# PGDUCKDB_VERSION=17-main

# pg_duckdb supports postgres 14 to 18
POSTGRESQL_VERSION=17
# https://github.com/duckdb/pg_duckdb/tags (or main)
PG_DUCKDB_VERSION=v1.1.1

## Override any variables you need
#ADMIN_USER=root
#ADMIN_PASSWORD=admin
#DB_NAME=postgres
#DB_PORT=5432
#DB_UI_PORT=8008
#MOTHERDUCK_TOKEN=your_token_here

#APP_DB_SCHEMA=public
APP_DB_NAME=db
APP_USER=user
APP_PASSWORD=pass
